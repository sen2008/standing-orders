{
  "name": "standing-orders-api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute standing-orders --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute standing-orders --remote --file=./schema.sql",
    "test": "vitest run"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240925.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1",
    "wrangler": "^3.78.0"
  },
  "dependencies": {
    "hono": "^4.6.2"
  }
}
